# URL du projet — Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publishable (nouveau format) OU anon key (legacy)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Clé secrète Supabase (nouveau format) OU service_role (legacy) — backend uniquement
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Clé pour l'extension Chrome → /api/receive-message
API_SECRET_KEY=ma-cle-secrete-changez-moi

# Clé API OpenAI pour communication directe avec GPT-4
OPENAI_API_KEY=sk-...
